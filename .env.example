# Copy to .env and adjust: cp .env.example .env
# Read by docker compose; values are injected into the containers.

# Match your host user so files created in bind mounts stay editable (`id -u`, `id -g`).
UID=1000
GID=1000

# PostgreSQL (Laravel reaches it at host "db", the compose service name).
DB_DATABASE=dualread
DB_USERNAME=dualread
DB_PASSWORD=change-me

# Host ports
APP_PORT=8000
FRONTEND_PORT=3000
DB_FORWARD_PORT=5432

# Public URL of the Laravel app as seen by browsers (used for media file URLs).
APP_URL=http://localhost:8000

# Requests per minute per client on the public API.
API_RATE_LIMIT=120

# Laravel API base for Nuxt: server-side (inside the Docker network) and browser-side.
NUXT_API_BASE_SERVER=http://app:8000/api/v1
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
